{
  "name": "streamline",
  "productName": "Streamline",
  "version": "0.1.0",
  "description": "Streamline - one small tray app for ASUS Aura lighting, fan control, sensors and motherboard driver updates.",
  "author": "JerricP",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "fetch:lhm": "node scripts/fetch-lhm.mjs",
    "dev": "node scripts/fetch-lhm.mjs && electron-vite dev",
    "build": "node scripts/fetch-lhm.mjs && electron-vite build",
    "start": "node scripts/fetch-lhm.mjs && electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.jerricp.streamline",
    "productName": "Streamline",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "resources/sensors",
        "to": "sensors"
      },
      {
        "from": "resources/lhm",
        "to": "lhm"
      }
    ]
  }
}
